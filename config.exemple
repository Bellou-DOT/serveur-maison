# Réglages de serveur-maison. installer.sh le copie dans /etc/serveur-maison.conf (à modifier là ensuite).
# Format CLE="valeur" : lu tel quel par bash, Python et systemd. Pas d'espace autour du « = ».

# ---------- Noms ----------
NOM_PORTAIL="MonServ"              # titre du portail web et des notifications
HOTE="monserv"                     # le portail répond sur http://monserv (par le DNS du VPN)

# ---------- Réseau de la maison ----------
IP_SERVEUR="192.168.1.20"          # adresse fixe du serveur : à réserver dans la box (bail DHCP statique)
RESEAU_MAISON="192.168.1.0/24"
INTERFACE="wlo1"                   # carte réseau du serveur (commande : ip -br link)
DOMAINE=""                         # adresse publique pour le VPN (ex. moi.duckdns.org) ; vide = IP publique
DUCKDNS_JETON=""                   # jeton DuckDNS si DOMAINE est en .duckdns.org (mise à jour de l'IP toutes les 5 min)

# Appareils de la maison qui ont accès aux outils d'admin (Radarr, Sonarr, Prowlarr, Transmission, AdGuard)
# sans passer par le VPN : leurs adresses MAC, séparées par des espaces. Le VPN y a toujours accès.
ADMINS_MAC=""

# PC à réveiller / mettre en veille depuis le portail (tuile « Mon PC ») ; vide = tuile cachée
PC_MAC=""
PC_IP=""

# ---------- Médias ----------
MEDIAS_BRUT="/srv/medias-brut"     # où Radarr et Sonarr rangent les fichiers (peut être un disque externe)
MEDIAS="/srv/medias"               # ce que lit Jellyfin : liens vers MEDIAS_BRUT (voir outils/vitrine.py)
DOSSIER_PRIVE=""                   # dossier de films à part (bibliothèque Jellyfin d'un seul compte) ; vide = aucun

# ---------- Ce qu'il faut installer (oui / non) ----------
AVEC_MEDIAS="oui"                  # Jellyfin, Radarr, Sonarr, Prowlarr, Seerr, Transmission, partage Samba
AVEC_PHOTOS="oui"                  # Immich (sauvegarde des photos du téléphone)
AVEC_SECURITE="oui"                # CrowdSec : bloque les adresses qui attaquent le serveur
FUSEAU="Europe/Paris"
