[Unit]
Description=Portail du serveur maison (http://HOTE, maison + VPN)
After=network-online.target

[Service]
# compte sans droits : une faille du portail ne donne pas le serveur
User=medias
Group=jellyfin
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 @ACCUEIL@/outils/portail.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
