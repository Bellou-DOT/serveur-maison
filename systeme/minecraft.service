[Unit]
Description=Serveur Minecraft (monde actif : ~/mc)
Conflicts=palworld.service
After=network-online.target
Wants=network-online.target

[Service]
User=@UTILISATEUR@
WorkingDirectory=@ACCUEIL@/mc
# La console lit console.in : une ligne ajoutée = une commande.
# exec : Java devient le processus principal, donc un plantage déclenche bien Restart=.
ExecStart=/bin/bash -c 'exec ./lancer.sh < <(tail -n0 -F console.in)'
Restart=on-failure
# 143 = arrêt demandé (SIGTERM) : normal, pas une panne
SuccessExitStatus=143
RestartSec=20
# Java sauvegarde le monde proprement sur SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
